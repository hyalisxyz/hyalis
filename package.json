{
  "name": "agent-utility",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "description": "Agent backend: LLM strategy brain, policy guardrails, price gate, paper broker and verifiable decision receipts on Robinhood Chain.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "tick": "node --env-file-if-exists=.env src/main.ts --once",
    "verify": "node src/cli/verify.ts",
    "sync-markets": "node scripts/sync-markets.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build:contracts": "forge build --root contracts && node scripts/export-registry.ts",
    "anchor:wallet": "node scripts/new-anchor-wallet.ts",
    "anchor:deploy": "node --env-file-if-exists=.env scripts/deploy-registry.ts",
    "test:fork": "node --env-file-if-exists=.env --test test/fork/*.fork.ts",
    "verify-epoch": "node --env-file-if-exists=.env src/cli/verify-epoch.ts",
    "restore": "node --env-file-if-exists=.env scripts/restore-backup.ts",
    "audit": "node --env-file-if-exists=.env scripts/audit-prod.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "viem": "^2.58.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}

# Copy to .env and run with: node --env-file=.env src/main.ts

# Needed only to create agents from a written strategy (the brain).
ANTHROPIC_API_KEY=

# Required for POST /agents. Without it, anyone who can reach the port can create agents.
ADMIN_TOKEN=

PORT=8787
HOST=127.0.0.1
DB_PATH=data/agent-utility.db

# Optional extra RPC tried before the public Robinhood Chain endpoints.
RPC_URL=

# Optional second price source and halt list. Blank = Chainlink only.
PLANKTON_API=https://plankton-gkmt.onrender.com

# Second price source for crypto (this key covers BTC and ETH only). Optional.
PYTH_API_KEY=
# Optional CoinGecko demo key for a higher rate limit; works without one.
COINGECKO_API_KEY=

# Project token (Pons launch). Leave empty until launch: every wallet is on the free tier.
TOKEN_ADDRESS=
# Tiers by whole tokens held. Default:
# [{"name":"Free","minTokens":0,"agents":1,"compilesPerDay":10},{"name":"Holder","minTokens":1000000,"agents":3,"compilesPerDay":50},{"name":"Whale","minTokens":5000000,"agents":10,"compilesPerDay":50}]
TOKEN_TIERS=
BURN_TOKENS_PER_SLOT=500000
BURN_SLOT_DAYS=30
# Domain shown in the wallet sign-in message (the website's domain).
APP_DOMAIN=localhost
# Set to true behind Railway's proxy so rate limits use the real client IP.
TRUST_PROXY=false

# ERC-8004 identities (Agent Passport). Agent registration files are served under PUBLIC_URL and
# their URLs are written on chain, so it must be the public address. Default: https://APP_DOMAIN.
PUBLIC_URL=
# After a domain move: the old base URLs, comma separated, so identities registered there still count.
LEGACY_PUBLIC_URLS=
# The ERC-8004 Identity Registry on Robinhood Chain.
IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
# Wallet that owns house agents' identities. Default: the anchor wallet.
HOUSE_IDENTITY_OWNER=

# Off-site backups (S3-compatible bucket). Uploads happen only where BACKUP_ENABLED=true
# (production); locally the credentials are for `npm run restore` only.
BACKUP_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_URL_STYLE=virtual
BACKUP_EVERY_HOURS=6

BRAIN_MODEL=claude-opus-5-5
# Public identity: what the AI calls itself, and the label stored on receipts instead of the model id.
BRAND_NAME=Hyalis
BRAIN_LABEL=brain-v1
TICK_SEC=300
EPOCH_SEC=3600

# Full database download at GET /v1/admin/export (operator token only). Turn on only while moving hosts.
ADMIN_EXPORT_ENABLED=false

# Agent avatars from an image service, paid per image with x402 (USDG on Robinhood Chain).
# Off unless all four are set. Create the payer wallet with: node scripts/new-media-wallet.ts
MEDIA_PAYER_KEY=
MEDIA_API=
MEDIA_MODEL=
MEDIA_PAY_TO=
MEDIA_MAX_USDG_PER_CALL=0.01
MEDIA_DAILY_USDG=0.25
